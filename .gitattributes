# Auto-detect text files
* text=auto

# Explicitly declare backend language (Java/Spring Boot)
*.java linguist-language=Java
*.kt linguist-language=Kotlin
*.xml linguist-language=XML
*.properties linguist-language=Properties
*.gradle linguist-language=Groovy

# Explicitly declare frontend language (Flutter/Dart)
*.dart linguist-language=Dart
*.pubspec linguist-language=YAML
*.yaml linguist-language=YAML
*.yml linguist-language=YAML

# Exclude generated/auto-generated files from language stats
*.class linguist-generated=true
*.jar linguist-generated=true
*.war linguist-generated=true
*.dex linguist-generated=true

# Exclude build directories from language stats
build/ linguist-generated=true
target/ linguist-generated=true
.gradle/ linguist-generated=true
.dart_tool/ linguist-generated=true

# Exclude IDE files from stats
.idea/ linguist-vendored=true
.vscode/ linguist-vendored=true
*.iml linguist-vendored=true
*.ipr linguist-vendored=true
*.iws linguist-vendored=true

# Exclude dependencies from stats
node_modules/ linguist-vendored=true
pubspec.lock linguist-generated=true
